rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Must match LOGIN_EMAILS.admin in lib/config.js
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@thursdaydarts.app';
    }

    // Anyone can READ everything (this is what lets the bar's TV show the board with no login).
    // Only the admin login can change roster, nights, settings and saved stats.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The scorer tablets (any signed-in user) may update scores inside a match.
    match /nights/{nightId}/matches/{matchId} {
      allow update: if signedIn();
    }
  }
}
